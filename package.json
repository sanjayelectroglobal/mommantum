{
  "name": "medusa-next",
  "version": "1.0.3",
  "private": true,
  "author": "Kasper Fabricius Kristensen <kasper@medusajs.com> & Victor Gerbrands <victor@medusajs.com> (https://www.medusajs.com)",
  "description": "Next.js Starter to be used with Medusa V2",
  "keywords": [
    "medusa-storefront"
  ],
  "scripts": {
    "dev": "next dev -p 8000",
    "dev:clean": "node -e \"const fs = require('fs'); try { fs.rmSync('.next', { recursive: true, force: true }); console.log('Cleaned .next build cache successfully'); } catch(e){}\" && next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@medusajs/icons": "latest",
    "@medusajs/ui": "latest",
    "@radix-ui/react-accordion": "^1.2.1",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/typography": "^0.5.19",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "15.3.9",
    "react": "19.0.4",
    "react-dom": "19.0.4",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0",
    "webpack": "^5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.17.5",
    "@medusajs/ui-preset": "latest",
    "@types/node": "17.0.21",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@types/react-instantsearch-dom": "^6.12.3",
    "autoprefixer": "^10.4.2",
    "babel-loader": "^8.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.8",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.0.23",
    "typescript": "^5.3.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "resolutions": {
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.4"
  },
  "overrides": {
    "react": "19.0.4",
    "react-dom": "19.0.4"
  },
  "packageManager": "npm@11.7.0"
}
